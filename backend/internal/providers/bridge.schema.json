{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wooinwoo/freeway-cli/main/backend/internal/providers/bridge.schema.json",
  "title": "Freeway provider bridge request or event",
  "description": "Current stdin JSON / stdout JSON Lines contract. This is not an HTTP API. Dynamic model readiness and reasoning choices require runtime validation.",
  "oneOf": [{ "$ref": "#/$defs/request" }, { "$ref": "#/$defs/event" }],
  "$defs": {
    "providerId": {
      "type": "string",
      "enum": ["kilo", "opencode", "cline", "nvidia", "zai", "requesty", "vikasit", "openrouter", "groq", "gemini_api", "novita"]
    },
    "message": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "developer", "user", "assistant"] },
        "content": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "provider": { "$ref": "#/$defs/providerId" },
        "baseURL": { "type": "string", "default": "http://127.0.0.1:4141", "description": "Loopback HTTP origin only; enforced by the client at runtime." },
        "key": { "type": "string", "minLength": 1, "maxLength": 4096, "writeOnly": true },
        "confirmFree": { "type": "boolean", "default": false },
        "model": { "type": "string", "minLength": 1 },
        "messages": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/message" } },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 32768, "default": 2048 },
        "reasoningEffort": { "type": "string", "minLength": 1, "description": "Must occur in the selected model's reasoning.efforts; not a global enum." }
      },
      "oneOf": [
        { "properties": { "action": { "const": "providers" } } },
        { "properties": { "action": { "const": "authenticate" } }, "required": ["provider"] },
        { "properties": { "action": { "enum": ["models", "quota"] } }, "required": ["provider"] },
        { "properties": { "action": { "const": "complete" } }, "required": ["provider", "model", "messages"] }
      ]
    },
    "reasoning": {
      "type": "object",
      "required": ["parameter", "efforts"],
      "properties": {
        "parameter": { "enum": [null, "reasoning", "reasoning_effort", "variant"] },
        "efforts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "name", "kind", "authUrl", "env"],
      "properties": {
        "id": { "$ref": "#/$defs/providerId" },
        "name": { "type": "string" },
        "kind": { "enum": ["openai", "opencode", "cli"] },
        "authUrl": { "type": "string" },
        "env": { "type": ["string", "null"] }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "upstreamId", "name", "ready", "reason", "reasoning"],
      "properties": {
        "id": { "type": "string" },
        "upstreamId": { "type": "string" },
        "name": { "type": "string" },
        "ready": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "reasoning": { "$ref": "#/$defs/reasoning" }
      }
    },
    "authResult": {
      "type": "object",
      "required": ["id", "status", "ready", "reason", "inferenceVerified", "modelCount"],
      "properties": {
        "id": { "$ref": "#/$defs/providerId" },
        "status": { "const": "configured" },
        "ready": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "inferenceVerified": { "const": false },
        "modelCount": { "type": "integer", "minimum": 0 }
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "bucket": {
      "type": "object",
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "quota": {
      "type": "object",
      "required": ["provider", "source", "authoritative", "observedAt", "ready", "reason", "limits", "usage", "localRemaining", "localTokenRemaining", "providerRemaining", "lastFailure"],
      "properties": {
        "provider": { "$ref": "#/$defs/providerId" },
        "source": { "const": "local_gateway" },
        "authoritative": { "const": false },
        "observedAt": { "type": "string", "format": "date-time" },
        "ready": { "type": "boolean" },
        "reason": { "type": ["string", "null"] },
        "limits": { "$ref": "#/$defs/counts" },
        "usage": { "type": "object", "additionalProperties": { "$ref": "#/$defs/bucket" } },
        "localRemaining": { "$ref": "#/$defs/counts" },
        "localTokenRemaining": { "$ref": "#/$defs/counts" },
        "providerRemaining": { "type": "null", "description": "No authoritative upstream remaining-allowance endpoint is currently implemented." },
        "lastFailure": { "type": ["object", "null"] }
      }
    },
    "completion": {
      "type": "object",
      "required": ["ok", "model", "provider", "content", "elapsedMs", "reasoningEffort"],
      "properties": {
        "ok": { "const": true },
        "model": { "type": "string" },
        "provider": { "$ref": "#/$defs/providerId" },
        "content": { "type": "string", "minLength": 1 },
        "elapsedMs": { "type": "integer" },
        "reasoningEffort": { "type": ["string", "null"] },
        "usage": { "type": "object" }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "status", "retryAfter"],
      "properties": {
        "code": { "type": "string" },
        "status": { "type": "integer" },
        "retryAfter": { "type": "integer", "minimum": 0, "description": "Seconds; 0 means no retry delay was supplied." }
      }
    },
    "event": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "properties": { "type": { "const": "text" }, "text": { "type": "string" } }, "required": ["text"] },
        { "properties": { "type": { "const": "error" }, "error": { "$ref": "#/$defs/error" } }, "required": ["error"] },
        {
          "properties": {
            "type": { "const": "result" },
            "result": { "anyOf": [
              { "type": "array", "items": { "$ref": "#/$defs/provider" } },
              { "type": "array", "items": { "$ref": "#/$defs/model" } },
              { "$ref": "#/$defs/authResult" },
              { "$ref": "#/$defs/quota" },
              { "$ref": "#/$defs/completion" }
            ] }
          },
          "required": ["result"]
        }
      ]
    }
  }
}
